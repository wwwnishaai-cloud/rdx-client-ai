# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rdx_client_ai
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rdx_client_ai

# RDX Auth
RDX_AUTH_SECRET=your-rdx-auth-jwt-secret
RDX_MAIN_SERVER=https://rdx-auth-recreate.onrender.com

# OpenCode Zen API (or any OpenAI-compatible API)
DEFAULT_API_KEY=sk-your-opencode-api-key
DEFAULT_MODEL=llama-3.3-70b-versatile
API_BASE_URL=https://api.opencode.ai/v1

# AI Settings
MAX_TOKENS=2048
TEMPERATURE=0.7
ALLOW_USER_KEYS=true

# Rate Limits
RATE_LIMIT_FREE=50
RATE_LIMIT_PREMIUM=999999

# Encryption (for storing user API keys)
ENCRYPTION_KEY=your-32-char-encryption-key-here!
